# ESPN Fantasy (required for private leagues)
# Copy espn_s2 and SWID from browser cookies while signed in.
# Keep the curly braces on SWID.
ESPN_S2=
ESPN_SWID=
ESPN_LEAGUE_ID=

# Optional. Team ID is your roster number in the ESPN URL / standings.
ESPN_TEAM_ID=
# Defaults to the current calendar year.
ESPN_SEASON=
# nfl, nba, mlb, nhl. Defaults to nfl.
ESPN_SPORT=nfl

# Writes stay preview-only unless both are set this way.
# ESPN_DRY_RUN=false
# ESPN_WRITES_ENABLED=true

# Optional ROS consensus (official FantasyPros API only; do not scrape).
# FANTASYPROS_API_KEY=
